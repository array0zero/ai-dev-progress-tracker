{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-dev-progress-tracker/schemas/progress-output.schema.json",
  "title": "AI Dev Progress Tracker — progress output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "currentPosition",
    "completedItems",
    "nextActions",
    "importantDecisions"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "currentPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "text", "evidenceIds"],
      "properties": {
        "status": { "type": "string", "enum": ["confirmed", "needs_input"] },
        "text": { "type": "string" },
        "evidenceIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "completedItems": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "items", "evidenceIds"],
      "properties": {
        "status": { "type": "string", "enum": ["confirmed", "needs_input"] },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "evidenceIds"],
            "properties": {
              "text": { "type": "string" },
              "evidenceIds": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "evidenceIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "nextActions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "items", "evidenceIds"],
      "properties": {
        "status": { "type": "string", "enum": ["confirmed", "needs_input"] },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "evidenceIds"],
            "properties": {
              "text": { "type": "string" },
              "evidenceIds": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "evidenceIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "importantDecisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "items", "evidenceIds"],
      "properties": {
        "status": { "type": "string", "enum": ["confirmed", "needs_input"] },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decision", "rationale", "evidenceIds"],
            "properties": {
              "decision": { "type": "string" },
              "rationale": { "type": "string" },
              "evidenceIds": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "evidenceIds": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
